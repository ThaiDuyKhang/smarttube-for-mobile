<?xml version="1.0" encoding="utf-8"?>
<!-- Phones and tablets build: the app must not require TV-only features -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">
    <!-- MissingLeanbackLauncher: the launcher activity is declared in the main manifest -->

    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:replace="android:required" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
        tools:replace="android:required" />

    <!-- Not every phone or tablet has them (declared by the libraries or implied by the permissions) -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false"
        tools:replace="android:required" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- Tell "no internet" apart from other errors -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background play: keep the CPU and Wi-Fi awake while the sound plays with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phones: no TV-only or risky permissions (deleting apps, drawing over other apps, starting on boot,
         recording audio: voice search uses the system speech screen). Fewer Play Protect warnings. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" tools:node="remove" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUICKBOOT_POWERON" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" tools:node="remove" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" tools:node="remove" />

    <application>
        <!-- Phone main screen (see MainApplication: registered instead of the TV one) -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileBrowseActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified" />

        <!-- Phone watch page -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobilePlaybackActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection|keyboardHidden"
            android:exported="false"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:showWhenLocked="true"
            android:supportsPictureInPicture="true"
            tools:targetApi="27" />

        <!-- Phone sign in and link device screens -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileSignInActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified" />

        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileAddDeviceActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified" />

        <!-- Phone channel page -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileChannelActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileChannelUploadsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified" />

        <!-- Background play (screen off) -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobilePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            tools:targetApi="29" />

        <!-- Buy the author a coffee -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileDonateActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false" />

        <!-- In-app updates from the GitHub releases (installs need REQUEST_INSTALL_PACKAGES) -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileUpdateActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false" />

        <!-- Phone search screen -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.MobileSearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <!-- Menus opened over a landscape video: created in landscape right away (no portrait frame then a rotation).
             Same setup as AppDialogActivity. Not used on Android 8.0: a translucent activity can't have a fixed orientation there. -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.dialogs.AppDialogActivityLandscape"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|layoutDirection"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/App.Theme.Leanback.Preferences"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
    </application>

</manifest>
