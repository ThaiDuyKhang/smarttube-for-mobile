<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile build: channel page -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/mobile_channel_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/mobile_ripple_borderless"
            android:contentDescription="@string/mobile_back"
            android:src="@drawable/mobile_ic_back" />

        <TextView
            android:id="@+id/mobile_channel_bar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mobile_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/mobile_channel_search_field"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/mobile_search_field_bg"
            android:hint="@string/mobile_channel_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/mobile_text"
            android:textColorHint="@color/mobile_text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/mobile_channel_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/mobile_ripple_borderless"
            android:contentDescription="@string/mobile_search"
            android:src="@drawable/mobile_ic_search" />

        <ImageButton
            android:id="@+id/mobile_channel_sort"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="@drawable/mobile_ripple_borderless"
            android:contentDescription="@string/mobile_sort"
            android:src="@drawable/mobile_ic_tune" />

        <ImageButton
            android:id="@+id/mobile_channel_more"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="@drawable/mobile_ripple_borderless"
            android:contentDescription="@string/mobile_more_options"
            android:src="@drawable/mobile_ic_more_vert" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_channel_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <ProgressBar
            android:id="@+id/mobile_channel_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
