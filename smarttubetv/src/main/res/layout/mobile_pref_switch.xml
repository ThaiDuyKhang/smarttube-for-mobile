<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile build: switch of the on/off rows in the menus (instead of a check box).
     switch_widget is only a lookup id here (androidx SwitchPreference finds the view by it on every API level). -->
<Switch xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/switch_widget"
    tools:ignore="NewApi"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:focusable="false"
    android:showText="false"
    android:switchMinWidth="48dp"
    android:textOff=""
    android:textOn=""
    android:thumb="@drawable/mobile_switch_thumb"
    android:track="@drawable/mobile_switch_track" />
