<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile build: watch page details (title, channel, actions, comments) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/mobile_watch_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/mobile_watch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/mobile_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mobile_watch_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mobile_watch_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autoLink="web"
            android:background="@drawable/mobile_card_round"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="@color/mobile_text"
            android:textColorLink="#3EA6FF"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mobile_watch_channel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/mobile_watch_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/mobile_circle_dark"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/mobile_watch_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/mobile_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mobile_watch_subscribers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxWidth="72dp"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mobile_watch_subscribe"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/mobile_round_button_light"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:maxLines="1"
            android:minWidth="88dp"
            android:singleLine="true"
            android:text="@string/mobile_subscribe"
            android:textColor="@color/mobile_text_on_light"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mobile_watch_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/mobile_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mobile_watch_like"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/mobile_like"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/mobile_ic_like"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/mobile_text"
                    android:textSize="14sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#4A4A4A" />

                <ImageButton
                    android:id="@+id/mobile_watch_dislike"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/mobile_dislike"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:src="@drawable/mobile_ic_dislike" />
            </LinearLayout>

            <TextView
                android:id="@+id/mobile_watch_share"
                style="@style/MobilePill"
                android:drawableStart="@drawable/mobile_ic_share"
                android:text="@string/mobile_share" />

            <TextView
                android:id="@+id/mobile_watch_save"
                style="@style/MobilePill"
                android:drawableStart="@drawable/mobile_ic_save"
                android:text="@string/mobile_save" />

            <TextView
                android:id="@+id/mobile_watch_background"
                style="@style/MobilePill"
                android:drawableStart="@drawable/mobile_ic_headphones"
                android:text="@string/mobile_background_play" />

            <TextView
                android:id="@+id/mobile_watch_speed"
                style="@style/MobilePill"
                android:text="@string/mobile_speed" />

            <TextView
                android:id="@+id/mobile_watch_quality"
                style="@style/MobilePill"
                android:text="@string/mobile_quality" />

            <TextView
                android:id="@+id/mobile_watch_repeat"
                style="@style/MobilePill"
                android:drawableStart="@drawable/mobile_ic_replay"
                android:text="@string/mobile_repeat" />

            <TextView
                android:id="@+id/mobile_watch_pip"
                style="@style/MobilePill"
                android:text="@string/mobile_pip" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/mobile_watch_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/mobile_pill_card_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mobile_comments"
            android:textColor="@color/mobile_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mobile_comments_hint"
            android:textColor="@color/mobile_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
