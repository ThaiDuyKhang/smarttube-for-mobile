<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile build: subscribed channel row (all subscriptions page) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/mobile_channel_item_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_circle_dark"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/mobile_channel_item_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/mobile_new_content_dot"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/mobile_channel_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/mobile_text"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/mobile_channel_item_bell"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/mobile_pill_bg"
        android:contentDescription="@string/mobile_notifications"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/mobile_ic_bell_off" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/mobile_ic_chevron_down" />
    </LinearLayout>
</LinearLayout>
