<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile build: group title of a list (settings), with a divider above it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/mobile_section_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/mobile_divider" />

    <TextView
        android:id="@+id/mobile_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/mobile_text"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
