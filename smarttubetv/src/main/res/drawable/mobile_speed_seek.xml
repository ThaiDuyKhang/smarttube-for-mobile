<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:top="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp"/>
            <solid android:color="@color/mobile_divider_strong"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:top="8dp" android:bottom="8dp">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp"/>
                <solid android:color="@color/mobile_text"/>
            </shape>
        </clip>
    </item>
</layer-list>
