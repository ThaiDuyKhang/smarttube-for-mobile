<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile build: switch track (like the YouTube app) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <size android:width="48dp" android:height="28dp"/>
            <solid android:color="@color/mobile_switch_track_on"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <size android:width="48dp" android:height="28dp"/>
            <solid android:color="@color/mobile_switch_track_off"/>
        </shape>
    </item>
</selector>
