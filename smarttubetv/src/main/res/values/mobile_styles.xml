<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Mobile build: phone UI theme (dark, system bars visible) -->
    <style name="MobileTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/mobile_bg</item>
        <item name="android:colorBackground">@color/mobile_bg</item>
        <item name="android:textColor">@color/mobile_text</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/mobile_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/mobile_bg</item>
        <item name="android:windowTranslucentStatus" tools:targetApi="19">false</item>
        <item name="android:windowTranslucentNavigation" tools:targetApi="19">false</item>
        <item name="android:windowAnimationStyle">@style/MobileWindowAnimation</item>
        <!-- Material press effect (grey ripple) instead of the old orange highlight of Theme.Black -->
        <item name="android:selectableItemBackground">@drawable/mobile_ripple</item>
        <item name="android:selectableItemBackgroundBorderless" tools:targetApi="21">@drawable/mobile_ripple_borderless</item>
        <item name="android:colorControlHighlight" tools:targetApi="21">@color/mobile_ripple</item>
    </style>

    <!-- Short fades between the screens (no TV slide), e.g. a short opens in place -->
    <style name="MobileWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/mobile_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/mobile_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/mobile_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/mobile_fade_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/mobile_fade_in</item>
        <item name="android:taskOpenExitAnimation">@anim/mobile_fade_out</item>
        <item name="android:taskCloseEnterAnimation">@anim/mobile_fade_in</item>
        <item name="android:taskCloseExitAnimation">@anim/mobile_fade_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/mobile_fade_in</item>
        <item name="android:taskToFrontExitAnimation">@anim/mobile_fade_out</item>
        <item name="android:taskToBackEnterAnimation">@anim/mobile_fade_in</item>
        <item name="android:taskToBackExitAnimation">@anim/mobile_fade_out</item>
    </style>

    <style name="MobilePlayerButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/mobile_ripple_borderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="MobileShortsAction">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/mobile_ripple_borderless</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:maxLines">1</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Rounded buttons of the watch page (like, share, save...) -->
    <style name="MobilePill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/mobile_pill_bg</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/mobile_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Menus and settings dialogs (bottom sheets): the colors of the light or dark theme -->
    <style name="MobileDialogTheme" parent="App.Theme.Leanback.Preferences">
        <item name="android:textColorPrimary">@color/mobile_text</item>
        <item name="android:textColorSecondary">@color/mobile_text_secondary</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/mobile_accent</item>
        <item name="android:colorControlHighlight" tools:targetApi="21">@color/mobile_ripple</item>
        <item name="android:selectableItemBackground">@drawable/mobile_ripple</item>
        <item name="defaultBrandColor">@color/mobile_surface</item>
        <item name="android:windowAnimationStyle">@style/MobileSheetAnimation</item>
    </style>

    <!-- Sheets slide up when opened and down when closed -->
    <style name="MobileSheetAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/mobile_sheet_in</item>
        <item name="android:activityOpenExitAnimation">@anim/mobile_none</item>
        <item name="android:activityCloseEnterAnimation">@anim/mobile_none</item>
        <item name="android:activityCloseExitAnimation">@anim/mobile_sheet_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/mobile_sheet_in</item>
        <item name="android:taskCloseExitAnimation">@anim/mobile_sheet_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/mobile_sheet_in</item>
    </style>

    <!-- The quick settings of the player (a dialog inside the player) -->
    <style name="MobileDialogWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/mobile_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/mobile_sheet_out</item>
    </style>
</resources>
